{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "mode": {
      "type": "string",
      "enum": [
        "standard",
        "custom"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationEstimate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "preflight",
              "arrival",
              "attention",
              "settling",
              "deepening",
              "main",
              "intensification",
              "release",
              "return",
              "exit",
              "custom"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "enabled": {
            "type": "boolean"
          },
          "narration": {
            "type": "string",
            "maxLength": 100000
          },
          "estimatedDuration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "manualDurationOverride": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "voiceSettings": {
            "type": "object",
            "properties": {
              "voiceId": {
                "type": "string",
                "maxLength": 256
              },
              "rate": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2
              },
              "pitch": {
                "type": "number",
                "minimum": -12,
                "maximum": 12
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 1
              }
            },
            "required": [
              "voiceId",
              "rate",
              "pitch"
            ],
            "additionalProperties": false
          },
          "visualSettings": {
            "type": "object",
            "properties": {
              "resolution": {
                "type": "string",
                "enum": [
                  "1280x720",
                  "1920x1080",
                  "3840x2160"
                ]
              },
              "backgroundColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "mediaReference": {
                "type": "string",
                "maxLength": 4096,
                "default": ""
              },
              "backgroundType": {
                "type": "string",
                "enum": [
                  "none",
                  "color",
                  "gradient",
                  "image",
                  "video",
                  "gif"
                ],
                "default": "color"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 1
              },
              "blur": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "default": 0
              },
              "zoomAmount": {
                "type": "number",
                "minimum": 0,
                "maximum": 5,
                "default": 0
              },
              "pulseAmount": {
                "type": "number",
                "minimum": 0,
                "maximum": 5,
                "default": 0
              },
              "panAmount": {
                "type": "number",
                "minimum": -20,
                "maximum": 20,
                "default": 0
              },
              "brightness": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 2,
                "default": 1
              },
              "brightnessPulse": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0
              },
              "fit": {
                "type": "string",
                "enum": [
                  "cover",
                  "contain",
                  "center"
                ],
                "default": "cover"
              },
              "gradient": {
                "type": "string",
                "maxLength": 512,
                "default": "linear-gradient(180deg, #101319, #202936)"
              },
              "fixation": {
                "type": "string",
                "enum": [
                  "none",
                  "point",
                  "spiral"
                ],
                "default": "none"
              },
              "transitionType": {
                "type": "string",
                "enum": [
                  "none",
                  "fade",
                  "crossfade"
                ],
                "default": "none"
              }
            },
            "required": [
              "resolution",
              "backgroundColor"
            ],
            "additionalProperties": false
          },
          "audioSettings": {
            "type": "object",
            "properties": {
              "narrationLevel": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "musicReference": {
                "type": "string",
                "maxLength": 4096,
                "default": ""
              },
              "ambientReference": {
                "type": "string",
                "maxLength": 4096,
                "default": ""
              },
              "musicLevel": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ambientLevel": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "effectsLevel": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.3
              },
              "fadeInDuration": {
                "type": "number",
                "minimum": 0,
                "maximum": 300,
                "default": 0
              },
              "fadeOutDuration": {
                "type": "number",
                "minimum": 0,
                "maximum": 300,
                "default": 0
              }
            },
            "required": [
              "narrationLevel",
              "musicLevel",
              "ambientLevel"
            ],
            "additionalProperties": false
          },
          "captionSettings": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "full-narration",
                  "selected-phrases",
                  "emphasis-only",
                  "none"
                ],
                "default": "full-narration"
              },
              "fontSize": {
                "type": "integer",
                "minimum": 8,
                "maximum": 200,
                "default": 32
              },
              "alignment": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ],
                "default": "center"
              },
              "position": {
                "type": "string",
                "enum": [
                  "top",
                  "middle",
                  "bottom"
                ],
                "default": "bottom"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 1
              },
              "displayDuration": {
                "type": "number",
                "minimum": 0,
                "maximum": 300,
                "default": 0
              },
              "fadeDuration": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "default": 0.25
              },
              "selectedPhrases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                },
                "maxItems": 50,
                "default": []
              }
            },
            "required": [
              "enabled"
            ],
            "additionalProperties": false
          },
          "transitionSettings": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "none",
                  "fade",
                  "crossfade"
                ]
              },
              "duration": {
                "type": "number",
                "minimum": 0,
                "maximum": 30
              }
            },
            "required": [
              "type",
              "duration"
            ],
            "additionalProperties": false
          },
          "notes": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "enabled",
          "narration",
          "estimatedDuration",
          "voiceSettings",
          "visualSettings",
          "audioSettings",
          "captionSettings",
          "transitionSettings",
          "notes"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "sourceImports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "fileName": {
            "type": "string",
            "maxLength": 512
          },
          "originalText": {
            "type": "string",
            "maxLength": 1000000
          },
          "importedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "fileName",
          "originalText",
          "importedAt"
        ],
        "additionalProperties": false
      },
      "maxItems": 20,
      "default": []
    },
    "audioSettings": {
      "type": "object",
      "properties": {
        "narrationLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "musicReference": {
          "type": "string",
          "maxLength": 4096,
          "default": ""
        },
        "ambientReference": {
          "type": "string",
          "maxLength": 4096,
          "default": ""
        },
        "musicLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambientLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "effectsLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3
        },
        "fadeInDuration": {
          "type": "number",
          "minimum": 0,
          "maximum": 300,
          "default": 0
        },
        "fadeOutDuration": {
          "type": "number",
          "minimum": 0,
          "maximum": 300,
          "default": 0
        }
      },
      "required": [
        "narrationLevel",
        "musicLevel",
        "ambientLevel"
      ],
      "additionalProperties": false
    },
    "visualSettings": {
      "type": "object",
      "properties": {
        "resolution": {
          "type": "string",
          "enum": [
            "1280x720",
            "1920x1080",
            "3840x2160"
          ]
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "mediaReference": {
          "type": "string",
          "maxLength": 4096,
          "default": ""
        },
        "backgroundType": {
          "type": "string",
          "enum": [
            "none",
            "color",
            "gradient",
            "image",
            "video",
            "gif"
          ],
          "default": "color"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "blur": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        },
        "zoomAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "pulseAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "panAmount": {
          "type": "number",
          "minimum": -20,
          "maximum": 20,
          "default": 0
        },
        "brightness": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 2,
          "default": 1
        },
        "brightnessPulse": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain",
            "center"
          ],
          "default": "cover"
        },
        "gradient": {
          "type": "string",
          "maxLength": 512,
          "default": "linear-gradient(180deg, #101319, #202936)"
        },
        "fixation": {
          "type": "string",
          "enum": [
            "none",
            "point",
            "spiral"
          ],
          "default": "none"
        },
        "transitionType": {
          "type": "string",
          "enum": [
            "none",
            "fade",
            "crossfade"
          ],
          "default": "none"
        }
      },
      "required": [
        "resolution",
        "backgroundColor"
      ],
      "additionalProperties": false
    },
    "safetyReview": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-reviewed",
            "reviewed"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 10000
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lastScannedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scannerVersion": {
          "type": "string",
          "maxLength": 64,
          "default": ""
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 512
              },
              "ruleId": {
                "type": "string",
                "maxLength": 128
              },
              "blockId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "required-review"
                ]
              },
              "category": {
                "type": "string",
                "maxLength": 128
              },
              "matchedText": {
                "type": "string",
                "maxLength": 2000
              },
              "startOffset": {
                "type": "integer",
                "minimum": 0
              },
              "endOffset": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "enum": [
                  "unresolved",
                  "reviewed",
                  "dismissed",
                  "edited"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 5000,
                "default": ""
              },
              "present": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "id",
              "ruleId",
              "blockId",
              "severity",
              "category",
              "matchedText",
              "startOffset",
              "endOffset",
              "status"
            ],
            "additionalProperties": false
          },
          "maxItems": 2000,
          "default": []
        },
        "structuralChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "maxLength": 256
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "required-review"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "missing"
                ]
              },
              "explanation": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "id",
              "label",
              "severity",
              "status",
              "explanation"
            ],
            "additionalProperties": false
          },
          "maxItems": 100,
          "default": []
        },
        "reviewerAcknowledged": {
          "type": "boolean",
          "default": false
        },
        "unresolvedCount": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "status",
        "notes"
      ],
      "additionalProperties": false
    },
    "exportSettings": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "maxLength": 4096
        },
        "resolution": {
          "type": "string",
          "enum": [
            "1280x720",
            "1920x1080",
            "3840x2160"
          ]
        },
        "captionsEnabled": {
          "type": "boolean"
        }
      },
      "required": [
        "directory",
        "resolution",
        "captionsEnabled"
      ],
      "additionalProperties": false
    },
    "experimentMetadata": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 256
        },
        "notes": {
          "type": "string",
          "maxLength": 10000
        }
      },
      "required": [
        "label",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "mode",
    "createdAt",
    "updatedAt",
    "durationEstimate",
    "blocks",
    "audioSettings",
    "visualSettings",
    "safetyReview",
    "exportSettings",
    "experimentMetadata"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local studio window can call bounded session and settings operations.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-destroy",
    "allow-list-sessions",
    "allow-load-session",
    "allow-save-session",
    "allow-trash-session",
    "allow-load-settings",
    "allow-save-settings"
  ]
}
